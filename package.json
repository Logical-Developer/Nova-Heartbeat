{
  "name": "nova-heartbeat",
  "version": "0.0.4",
  "description": "Nova Heartbeat — automated page rotation and construct-to-upgrade conversion",
  "author": "Logical-Developer",
  "license": "MIT",
  "homepage": "https://github.com/Logical-Developer/Nova-Heartbeat",
  "repository": {
    "type": "git",
    "url": "https://github.com/Logical-Developer/Nova-Heartbeat.git"
  },
  "scripts": {
    "build": "node build.js",
    "build:fm": "node plugins/FarmManager/build.js",
    "build:ara": "node plugins/AttackReportAnalyzer/build.js",
    "watch": "node watch.js",
    "check": "node --check Nova-Heartbeat.user.js",
    "check:plugins": "node --check plugins/Nova-Builder/Nova-Builder.user.js && node --check plugins/FarmManager/FarmManager.user.js && node --check plugins/AttackReportAnalyzer/AttackReportAnalyzer.user.js"
  }
}
